@{
    var currentPage = ViewBag.CurrentPage as string;

    bool isMgmtOpen = currentPage == "Courses" || currentPage == "Professors" || currentPage == "Students";
}

<div class="d-flex flex-column flex-shrink-0 p-4 h-100 text-white" style="background-color: #0f172a;">

    <div class="d-flex align-items-center gap-3 mb-5 px-2">
        <div class="d-flex align-items-center justify-content-center shadow-lg"
             style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #3b82f6, #2563eb);">
            <i class="bi bi-building-fill fs-4 text-white"></i>
        </div>
        <div style="line-height: 1.2;">
            <h1 class="fs-5 fw-bold mb-0 text-white" style="letter-spacing: -0.5px;">UniGrades</h1>
            <small class="text-white-50" style="font-size: 11px;">Portal Γραμματείας</small>
        </div>
    </div>

    <ul class="nav flex-column mb-auto gap-2">

        <li class="nav-item">
            <a href="/Secretary/Index"
               class="nav-link d-flex align-items-center px-3 py-3 rounded-3 sidebar-link @(currentPage == "Home" ? "active-link" : "text-white-50")">
                <i class="bi bi-grid-fill me-3 fs-5"></i>
                <span class="fw-medium">Επισκόπηση</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="#secrMgmtSubmenu" data-bs-toggle="collapse"
               class="nav-link d-flex align-items-center justify-content-between px-3 py-3 rounded-3 sidebar-link @(isMgmtOpen ? "text-white bg-slate-800" : "text-white-50")"
               aria-expanded="@(isMgmtOpen ? "true" : "false")">
                <div class="d-flex align-items-center">
                    <i class="bi bi-bank2 me-3 fs-5"></i>
                    <span class="fw-medium">Πανεπιστήμιο</span>
                </div>
                <i class="bi bi-chevron-down small transition-icon @(isMgmtOpen ? "rotate-180" : "")"></i>
            </a>

            <div class="collapse @(isMgmtOpen ? "show" : "") mt-1" id="secrMgmtSubmenu">
                <ul class="nav flex-column ps-3 border-start border-secondary border-opacity-25 ms-3">

                    <li class="nav-item">
                        <a href="/Secretary/ManageCourses"
                           class="nav-link d-flex align-items-center py-2 sub-link @(currentPage == "Courses" ? "active-sub" : "text-white-50")">
                            <i class="bi bi-journal-text me-2"></i>
                            Μαθήματα
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/Secretary/ManageProfessors"
                           class="nav-link d-flex align-items-center py-2 sub-link @(currentPage == "Professors" ? "active-sub" : "text-white-50")">
                            <i class="bi bi-person-badge me-2"></i>
                            Καθηγητές
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/Secretary/ManageStudents"
                           class="nav-link d-flex align-items-center py-2 sub-link @(currentPage == "Students" ? "active-sub" : "text-white-50")">
                            <i class="bi bi-mortarboard me-2"></i>
                            Φοιτητές
                        </a>
                    </li>

                </ul>
            </div>
        </li>

        <li class="nav-item mt-3 px-3">
            <small class="text-uppercase fw-bold text-white-50 opacity-50" style="font-size: 0.7rem;">Ενεργειες</small>
        </li>

        <li class="nav-item">
            <a href="/Secretary/CreateCourse"
               class="nav-link d-flex align-items-center px-3 py-3 rounded-3 sidebar-link @(currentPage == "CreateCourse" ? "active-link" : "text-white-50")">
                <i class="bi bi-plus-circle-fill me-3 fs-5"></i>
                <span class="fw-medium">Νέο Μάθημα</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="/Secretary/AssignStudentToCourse"
               class="nav-link d-flex align-items-center px-3 py-3 rounded-3 sidebar-link @(currentPage == "Assign" ? "active-link" : "text-white-50")">
                <i class="bi bi-pencil-fill me-3 fs-5"></i>
                <span class="fw-medium">Δήλωση Φοιτητή</span>
            </a>
        </li>

    </ul>

    <div class="mt-4 pt-4 border-top border-secondary border-opacity-25">
        <div class="bg-white bg-opacity-10 rounded-3 p-3 mb-3">
            <p class="text-white-50 mb-0" style="font-size: 11px;">Συνδεδεμένος ως</p>
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 10px;">S</div>
                <p class="fw-bold text-white mb-0 text-truncate">Γραμματεία</p>
            </div>
            <p class="text-white-50 mb-0" style="font-size: 11px;">Administrator</p>
        </div>

        <a href="/Account/Login" class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center border-opacity-25 text-white-50 hover-white">
            <i class="bi bi-box-arrow-right me-2"></i>
            Αποσύνδεση
        </a>
    </div>
</div>

<style>
    .sidebar-link {
        transition: all 0.2s ease;
    }

        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: white !important;
        }

    .active-link {
        background-color: #3b82f6 !important; 
        color: white !important;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .bg-slate-800 {
        background-color: rgba(30, 41, 59, 0.8);
        color: white !important;
    }

    .sub-link {
        font-size: 0.9rem;
        transition: all 0.2s;
    }

        .sub-link:hover {
            color: white !important;
            transform: translateX(5px);
        }

    .active-sub {
        color: #60a5fa !important;
        font-weight: 500;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }

    .transition-icon {
        transition: transform 0.3s ease;
    }

    .hover-white:hover {
        background-color: rgba(255,255,255,0.1);
        color: white !important;
        border-color: white;
    }
</style>