@{
    var currentPage = ViewBag.CurrentPage as string;
    
    bool isCoursesMenuOpen = currentPage == "MyCourses" || currentPage == "CourseDetails";
}

<div class="d-flex flex-column flex-shrink-0 p-4 h-100 text-white" style="background-color: #0f172a;">
    
    <div class="d-flex align-items-center gap-3 mb-5 px-2">
        <div class="d-flex align-items-center justify-content-center shadow-lg" 
             style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669);">
            <i class="bi bi-briefcase-fill fs-4 text-white"></i>
        </div>
        <div style="line-height: 1.2;">
            <h1 class="fs-5 fw-bold mb-0 text-white" style="letter-spacing: -0.5px;">UniGrades</h1>
            <small class="text-white-50" style="font-size: 11px;">Portal Καθηγητή</small>
        </div>
    </div>

    <ul class="nav flex-column mb-auto gap-2">
        
        <li class="nav-item">
            <a href="/Professor/Index/@ViewBag.ProfessorId" 
               class="nav-link d-flex align-items-center px-3 py-3 rounded-3 sidebar-link @(currentPage == "Home" ? "active-link" : "text-white-50")">
                <i class="bi bi-grid-fill me-3 fs-5"></i>
                <span class="fw-medium">Επισκόπηση</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="#profCoursesSubmenu" data-bs-toggle="collapse" 
               class="nav-link d-flex align-items-center justify-content-between px-3 py-3 rounded-3 sidebar-link @(isCoursesMenuOpen ? "text-white bg-slate-800" : "text-white-50")" 
               aria-expanded="@(isCoursesMenuOpen ? "true" : "false")">
                <div class="d-flex align-items-center">
                    <i class="bi bi-book-half me-3 fs-5"></i>
                    <span class="fw-medium">Τα Μαθήματά μου</span>
                </div>
                <i class="bi bi-chevron-down small transition-icon @(isCoursesMenuOpen ? "rotate-180" : "")"></i>
            </a>

            <div class="collapse @(isCoursesMenuOpen ? "show" : "") mt-1" id="profCoursesSubmenu">
                <ul class="nav flex-column ps-3 border-start border-secondary border-opacity-25 ms-3">

                    <li class="nav-item">
                        <a href="/Professor/MyCourses/@ViewBag.ProfessorId?mode=view"
                           class="nav-link d-flex align-items-center py-2 sub-link @(currentPage == "MyCourses_View" ? "active-sub" : "text-white-50")">
                            <i class="bi bi-eye me-2"></i>
                            Προβολή Βαθμολογίας
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/Professor/MyCourses/@ViewBag.ProfessorId?mode=enter"
                           class="nav-link d-flex align-items-center py-2 sub-link @(currentPage == "MyCourses_Enter" ? "active-sub" : "text-white-50")">
                            <i class="bi bi-pencil-square me-2"></i>
                            Καταχώρηση Βαθμολογίας
                        </a>
                    </li>

                </ul>
            </div>
        </li>
    </ul>

    <div class="mt-4 pt-4 border-top border-secondary border-opacity-25">
        <div class="bg-white bg-opacity-10 rounded-3 p-3 mb-3">
            <p class="text-white-50 mb-0" style="font-size: 11px;">Συνδεδεμένος ως</p>
            <p class="fw-bold text-white mb-0 text-truncate">@ViewBag.ProfessorName</p>
            <p class="text-white-50 mb-0" style="font-size: 11px;">Καθηγητής</p>
        </div>
        <a href="/Account/Login" class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center border-opacity-25 text-white-50 hover-white">
            <i class="bi bi-box-arrow-right me-2"></i>
            Αποσύνδεση
        </a>
    </div>
</div>

<style>
    .sidebar-link { transition: all 0.2s ease; }
    .sidebar-link:hover { background-color: rgba(255, 255, 255, 0.05); color: white !important; }
    
    .active-link { background-color: #10b981 !important; color: white !important; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }

    .bg-slate-800 { background-color: rgba(30, 41, 59, 0.8); color: white !important; }

    .sub-link { font-size: 0.9rem; transition: all 0.2s; }
    .sub-link:hover { color: white !important; transform: translateX(5px); }

    .active-sub { color: #34d399 !important; font-weight: 500; }

    .rotate-180 { transform: rotate(180deg); }
    .transition-icon { transition: transform 0.3s ease; }
    
    .hover-white:hover { background-color: rgba(255,255,255,0.1); color: white !important; border-color: white; }
</style>