@{
    Layout = "~/Views/Shared/_SecretaryLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewBag.CurrentPage = "Home";
}

<div class="d-flex align-items-center justify-content-between mb-5">
    <div class="d-flex align-items-center gap-4">
        <div class="bg-white p-3 rounded-4 shadow-sm border d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
            <i class="bi bi-mortarboard-fill text-primary fs-2"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark mb-1">Καλωσήρθατε, Γραμματεία</h2>
            <p class="text-muted mb-0">Σύστημα Διαχείρισης Βαθμολογίου Πανεπιστημίου</p>
        </div>
    </div>

    <div class="text-end d-none d-md-block">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fs-6 fw-normal">
            <i class="bi bi-calendar3 me-2"></i> @DateTime.Now.ToString("dd MMMM yyyy")
        </span>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Φοιτητες</span>
                    <div class="bg-primary bg-opacity-10 p-2 rounded-circle">
                        <i class="bi bi-mortarboard-fill text-primary fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-bold text-dark mb-0">@ViewBag.TotalStudents</h2>
                <span class="text-muted small">Εγγεγραμμένοι</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-purple bg-white" style="border-left-color: #6f42c1 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Καθηγητες</span>
                    <div class="bg-opacity-10 p-2 rounded-circle" style="background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-people-fill fs-5" style="color: #6f42c1;"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-bold text-dark mb-0">@ViewBag.TotalProfessors</h2>
                <span class="text-muted small">Διδακτικό Προσωπικό</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-success bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Μαθηματα</span>
                    <div class="bg-success bg-opacity-10 p-2 rounded-circle">
                        <i class="bi bi-journal-bookmark-fill text-success fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-bold text-dark mb-0">@ViewBag.TotalCourses</h2>
                <span class="text-muted small">Προσφερόμενα</span>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning bg-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small text-uppercase fw-bold">Ενεργα Εξαμηνα</span>
                    <div class="bg-warning bg-opacity-10 p-2 rounded-circle">
                        <i class="bi bi-graph-up-arrow text-warning fs-5"></i>
                    </div>
                </div>
                <h2 class="display-6 fw-bold text-dark mb-0">2</h2>
                <span class="text-muted small">Χειμερινό & Εαρινό</span>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <h4 class="mb-4 fw-bold text-dark">Γρήγορες Ενέργειες</h4>
    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <a href="/Secretary/ManageCourses" class="text-decoration-none">
                <div class="card h-100 shadow-sm border hover-effect p-4 text-center">
                    <div class="mx-auto mb-3 bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-journal-plus text-primary fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Διαχείριση Μαθημάτων</h5>
                    <p class="text-muted small mb-0">Προβολή και επεξεργασία</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="/Secretary/ManageProfessors" class="text-decoration-none">
                <div class="card h-100 shadow-sm border hover-effect p-4 text-center">
                    <div class="mx-auto mb-3 bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; background-color: rgba(111, 66, 193, 0.1);">
                        <i class="bi bi-people fs-3" style="color: #6f42c1;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Διαχείριση Καθηγητών</h5>
                    <p class="text-muted small mb-0">Εγγραφή διδασκόντων</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="/Secretary/ManageStudents" class="text-decoration-none">
                <div class="card h-100 shadow-sm border hover-effect p-4 text-center">
                    <div class="mx-auto mb-3 bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-mortarboard text-success fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Διαχείριση Φοιτητών</h5>
                    <p class="text-muted small mb-0">Μητρώο φοιτητών</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a href="/Secretary/AssignStudentToCourse" class="text-decoration-none">
                <div class="card h-100 shadow-sm border hover-effect p-4 text-center">
                    <div class="mx-auto mb-3 bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-clipboard-plus text-warning fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Δήλωση Μαθημάτων</h5>
                    <p class="text-muted small mb-0">Ανάθεση σε φοιτητές</p>
                </div>
            </a>
        </div>

    </div>
</div>

<style>
    /* CSS για το Hover effect στις κάρτες */
    .hover-effect {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        border-color: #e2e8f0; /* Slate-200 */
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border-color: #2563eb !important; /* Primary Blue */
        }
</style>