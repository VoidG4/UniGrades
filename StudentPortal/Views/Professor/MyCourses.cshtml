@model IEnumerable<StudentPortal.Models.Course>

@{
    Layout = "~/Views/Shared/_ProfessorLayout.cshtml";
    ViewData["Title"] = ViewBag.PageTitle;
    ViewData["PageHeaderTitle"] = ViewBag.PageTitle;
    ViewData["PageHeaderDesc"] = ViewBag.PageDesc;
    ViewData["PageHeaderIcon"] = "bi-journal-bookmark-fill";
}

<partial name="_PageHeader" />

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 hover-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="@(ViewBag.CurrentMode == "enter" ? "bg-success text-success" : "bg-primary text-primary") bg-opacity-10 rounded-circle p-3 me-3">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 200px;" title="@item.CourseTitle">@item.CourseTitle</h5>
                            <small class="text-muted">Εξάμηνο @item.CourseSemester</small>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-3">

                    <div class="d-grid">
                        <a href="/Professor/CourseDetails?courseId=@item.IdCourse&professorId=@ViewBag.ProfessorId&mode=@ViewBag.CurrentMode"
                           class="btn @ViewBag.ButtonColor fw-bold">
                            <i class="bi @ViewBag.ButtonIcon me-2"></i>@ViewBag.ButtonText
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>