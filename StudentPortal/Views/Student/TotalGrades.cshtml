@model IEnumerable<StudentPortal.Models.CourseHasStudent>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    ViewData["Title"] = "Συνολική Βαθμολογία";
    ViewData["PageHeaderTitle"] = "Αναλυτική Βαθμολογία";
    ViewData["PageHeaderDesc"] = "Συγκεντρωτική κατάσταση όλων των μαθημάτων";
    ViewData["PageHeaderIcon"] = "bi-file-earmark-text";

    var passedCourses = Model.Where(m => m.GradeCourseStudent >= 5).ToList();
    var average = passedCourses.Any() ? passedCourses.Average(m => m.GradeCourseStudent.Value).ToString("0.00") : "-";
    var totalPassed = passedCourses.Count;
    var totalCourses = Model.Count();
}

<partial name="_PageHeader" />

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-primary text-white h-100 overflow-hidden">
            <div class="card-body position-relative p-4">
                <h3 class="display-5 fw-bold mb-0">@average</h3>
                <p class="mb-0 text-white-50">Μέσος Όρος Πτυχίου</p>
                <i class="bi bi-trophy position-absolute top-50 end-0 translate-middle-y me-4 text-white opacity-25" style="font-size: 4rem;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-success text-white h-100 overflow-hidden">
            <div class="card-body position-relative p-4">
                <h3 class="display-5 fw-bold mb-0">@totalPassed <span class="fs-4 text-white-50">/ @totalCourses</span></h3>
                <p class="mb-0 text-white-50">Περασμένα Μαθήματα</p>
                <i class="bi bi-check-circle position-absolute top-50 end-0 translate-middle-y me-4 text-white opacity-25" style="font-size: 4rem;"></i>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">Λίστα Μαθημάτων</h5>
        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-2"></i>Εκτύπωση
        </button>
    </div>

    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <p>Δεν βρέθηκαν εγγραφές.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle" style="table-layout: fixed;">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 40%;">Μάθημα</th>

                        <th class="text-center" style="width: 20%;">Βαθμός</th>

                        <th class="text-end pe-4" style="width: 40%;">Κατάσταση</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-truncate">
                                <div class="fw-medium text-dark text-truncate" title="@item.CourseIdCourseNavigation.CourseTitle">
                                    @item.CourseIdCourseNavigation.CourseTitle
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>Εξάμηνο @item.CourseIdCourseNavigation.CourseSemester
                                </div>
                            </td>

                            <td class="text-center">
                                @if (item.GradeCourseStudent.HasValue)
                                {
                                    <span class="fw-bold fs-5 text-dark">@item.GradeCourseStudent</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                @if (!item.GradeCourseStudent.HasValue)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">Εκκρεμεί</span>
                                }
                                else if (item.GradeCourseStudent >= 5)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Επιτυχία</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Αποτυχία</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    @@media print {
        body * {
            visibility: hidden;
        }
        .card, .card * {
            visibility: visible;
        }

        .card {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }

        .btn, .col-md-3, .position-fixed {
            display: none !important;
        }

        .col-md-9, .col-lg-10 {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>