@model IEnumerable<StudentPortal.Models.CourseHasStudent>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    ViewData["Title"] = "Ανά Μάθημα";
    ViewData["PageHeaderTitle"] = "Βαθμολογία Ανά Μάθημα";
    ViewData["PageHeaderDesc"] = "Αναλυτική λίστα μαθημάτων με αλφαβητική σειρά";
    ViewData["PageHeaderIcon"] = "bi-book";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Μάθημα</th>
                    <th>Εξάμηνο</th>
                    <th class="text-center">Βαθμός</th>
                    <th class="text-end pe-4">Κατάσταση</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-medium">@item.CourseIdCourseNavigation.CourseTitle</td>
                        <td>@item.CourseIdCourseNavigation.CourseSemester</td>
                        <td class="text-center fw-bold">
                            @if (item.GradeCourseStudent.HasValue)
                            {
                                @item.GradeCourseStudent
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            @if (!item.GradeCourseStudent.HasValue)
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">Εκκρεμεί</span>
                            }
                            else if (item.GradeCourseStudent >= 5)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">Επιτυχία</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">Αποτυχία</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>