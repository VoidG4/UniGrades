@model IEnumerable<StudentPortal.Models.CourseHasStudent>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    ViewData["Title"] = "Ανά Εξάμηνο";
    ViewData["PageHeaderTitle"] = "Ιστορικό Ανά Εξάμηνο";
    ViewData["PageHeaderDesc"] = "Οι επιδόσεις σας χωρισμένες ανά ακαδημαϊκό εξάμηνο";
    ViewData["PageHeaderIcon"] = "bi-clipboard-data";
}

<partial name="_PageHeader" />

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Δεν βρέθηκαν εγγραφές.
    </div>
}

@foreach (var group in Model.GroupBy(m => m.CourseIdCourseNavigation.CourseSemester).OrderBy(g => g.Key))
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h5 class="mb-0 fw-bold text-primary">
                <i class="bi bi-calendar3 me-2"></i>Εξάμηνο @group.Key
            </h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle" style="table-layout: fixed;">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 40%;">Μάθημα</th>

                        <th class="text-center" style="width: 20%;">Βαθμός</th>

                        <th class="text-end pe-4" style="width: 40%;">Κατάσταση</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in group)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-truncate" title="@item.CourseIdCourseNavigation.CourseTitle">
                                @item.CourseIdCourseNavigation.CourseTitle
                            </td>

                            <td class="text-center fw-bold fs-5">
                                @if (item.GradeCourseStudent.HasValue)
                                {
                                    @item.GradeCourseStudent
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                @if (!item.GradeCourseStudent.HasValue)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">Εκκρεμεί</span>
                                }
                                else if (item.GradeCourseStudent >= 5)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Επιτυχία</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Αποτυχία</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}